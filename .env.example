# IG Markets Credentials (REQUIRED)
# Your IG account username
IG_USERNAME=your_ig_username

# Your IG account password
IG_PASSWORD=your_ig_password

# Your IG API key (obtain from IG account settings)
IG_API_KEY=your_ig_api_key

# Your IG account number (e.g., ZXXXXX)
IG_ACC_NUMBER=ZXXXXXX

# Account type: LIVE or DEMO (default: DEMO)
IG_ACC_TYPE=DEMO

# Comma-separated list of epics to subscribe to (REQUIRED)
# Example: CS.D.EURUSD.MINI.IP,CS.D.GBPUSD.MINI.IP
IG_EPICS=CS.D.EURUSD.MINI.IP

# ZeroMQ Configuration (OPTIONAL)
# PUB socket bind address for publishing prices/account/trade messages
# Default: tcp://127.0.0.1:5555
ZMQ_PUB_ADDR=tcp://127.0.0.1:5555

# SUB socket bind address for receiving order commands
# Default: tcp://127.0.0.1:5556
ZMQ_SUB_ADDR=tcp://127.0.0.1:5556

# SQLite Configuration (OPTIONAL)
# Directory in which timestamped price tick databases will be created
# Default: . (current directory)
SQLITE_DIR=.

# Nightly Guard Configuration (OPTIONAL)
# UTC hour at which order processing is paused for nightly maintenance (0-23)
# Default: 22 (10 PM UTC)
ORDER_PAUSE_HOUR=22

# Minutes after ORDER_PAUSE_HOUR at which orders resume processing (0-1440)
# Default: 30 (orders resume at 22:30 UTC)
ORDER_RESUME_MINS=30
