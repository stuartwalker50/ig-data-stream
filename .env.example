# IG Markets API Credentials
export IG_USERNAME=your_username
export IG_PASSWORD=your_password
export IG_API_KEY=your_api_key
export IG_ACC_NUMBER=your_account_number  # account ID (e.g. ABC1234), NOT your login username – used as the Lightstreamer credential

# Account Type: LIVE or DEMO (default: DEMO)
export IG_ACC_TYPE=DEMO

# Comma-separated list of EPICs to subscribe to
export IG_EPICS=CS.D.EURUSD.MINI.IP,CS.D.GBPUSD.MINI.IP

# ZeroMQ Addresses
export ZMQ_PUB_ADDR=tcp://127.0.0.1:5555
export ZMQ_SUB_ADDR=tcp://127.0.0.1:5556

# SQLite storage directory (default: current directory)
export SQLITE_DIR=.

# Nightly maintenance window (UTC)
# Hour at which order processing pauses (default: 22)
export ORDER_PAUSE_HOUR=22
# Minutes after pause hour when orders resume (default: 30)
export ORDER_RESUME_MINS=30

# Reconnection Retry Configuration
# Maximum number of reconnection attempts (default: 10)
export MAX_RECONNECT_ATTEMPTS=10
# Initial retry delay in seconds (default: 2)
export INITIAL_RETRY_DELAY=2
# Maximum retry delay in seconds (default: 300, i.e., 5 minutes)
export MAX_RETRY_DELAY=300
